# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Clerk Authentication (Client-side - VITE_ prefix required)
# Get these from: https://dashboard.clerk.com
VITE_CLERK_PUBLISHABLE_KEY="pk_test_xxxxx"

# Firebase Configuration (For Firestore Database only - VITE_ prefix required)
VITE_FIREBASE_API_KEY="your_firebase_api_key"
VITE_FIREBASE_AUTH_DOMAIN="your_project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your_project_id"
VITE_FIREBASE_STORAGE_BUCKET="your_project.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="your_sender_id"
VITE_FIREBASE_APP_ID="your_app_id"

# Dodo Payments Configuration (Server-side)
DODO_PAYMENTS_TOKEN="your_dodo_payments_bearer_token"
DODO_WEBHOOK_SECRET="your_webhook_secret"

# Dodo Payments Product/Price IDs
# Create these in your Dodo Payments dashboard: https://app.dodopayments.com
DODO_PRICE_STUDENT="price_xxxxx"  # $2.99/month student plan
DODO_PRICE_PREMIUM="price_xxxxx"  # $4.99/month premium plan
DODO_PRICE_FOUNDER="price_xxxxx"  # $14.99/month founder plan




