# --- AI / Gemini (server-side, used by Node) ---
# Get yours at https://aistudio.google.com/apikey
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# --- App self-URL (used for OAuth callbacks / self-referential links) ---
APP_URL="http://localhost:3000"

# --- Dodo Payments (server-side) ---
# Get test token at https://app.dodopayments.com/dashboard/developer
DODO_PAYMENTS_TOKEN="MY_DODO_PAYMENTS_TOKEN"
DODO_WEBHOOK_SECRET="MY_DODO_WEBHOOK_SECRET"

# --- Auth0 (client-side, VITE_-prefixed for Vite) ---
# Get these from your Auth0 application settings.
# Make sure the Auth0 dashboard has:
#   Allowed Callback URLs:   http://localhost:3000
#   Allowed Logout URLs:      http://localhost:3000
#   Allowed Web Origins:      http://localhost:3000
VITE_AUTH0_DOMAIN="YOUR_AUTH0_DOMAIN.us.auth0.com"
VITE_AUTH0_CLIENT_ID="YOUR_AUTH0_CLIENT_ID"

# --- Firebase (client-side) ---
# The defaults in src/firebase.ts already point at a sample Firebase project.
# Override here only if you want to use your own Firebase project.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
