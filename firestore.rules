rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Common Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\+:]+$');
    }

    // 2. Scores Collection Rules
    match /scores/{scoreId} {
      allow create: if isValidId(scoreId)
                    && request.resource.data.userId != null
                    && isValidId(request.resource.data.userId)
                    && (isSignedIn() ? request.resource.data.userId == request.auth.uid : request.resource.data.userId.startsWith('g_'));
      
      allow read, update, delete: if isValidId(scoreId)
                                  && resource.data.userId != null
                                  && (isSignedIn() ? resource.data.userId == request.auth.uid : resource.data.userId.startsWith('g_'));
    }

    // 3. Users Collection Rules
    match /users/{userId} {
      allow read, write: if isValidId(userId) && isOwner(userId);
    }
  }
}
